flowchart TB
    %% Styling Definitions
    classDef aiNode fill:#FFE0B2,stroke:#FB8C00,stroke-width:2px
    classDef hitlNode fill:#FFCDD2,stroke:#E53935,stroke-width:2px
    classDef fallbackNode fill:#ECEFF1,stroke:#607D8B,stroke-width:2px
    classDef orchestrator fill:#E1F5FE,stroke:#0288D1,stroke-width:2px
    classDef startEnd fill:#C8E6C9,stroke:#2E7D32,stroke-width:2px

    %% Subgraphs for 3 pillars
    subgraph Watcher ["Nguồn Dữ Liệu"]
        A(["Thư mục Watcher / Downloads / Cloud Drive"]):::startEnd
    end

    subgraph Orchestrator ["n8n (Orchestrator)"]
        B[Quét phát hiện file mới]:::orchestrator
        B_EMPTY{"Thư mục trống?"}:::orchestrator
        B_EXIT([Graceful Exit]):::startEnd
        
        C["Đọc metadata & Tính MD5 Hash"]:::orchestrator
        C_DUP{"MD5 Hash đã tồn tại?"}:::orchestrator
        C_DUP_MOVE["Di chuyển file vào /TrungLap/"]:::fallbackNode
        C_DUP_LOG["Ghi log trùng lặp & kết thúc"]:::orchestrator
        
        FORMAT_CHECK{"Định dạng file?"}:::orchestrator
        OCR_RUN["Chạy local OCR trích xuất text"]:::orchestrator
        OCR_OK{"OCR thành công?"}:::orchestrator
        
        API_CALL["Gọi API LLM (Retry 3 lần)"]:::orchestrator
        API_OK{"API thành công?"}:::orchestrator
        API_ERR_MOVE["Di chuyển file vào /LoiHeThong/"]:::fallbackNode
        API_ERR_ALERT["Ghi log lỗi & Alert Slack"]:::fallbackNode
        
        G{"Confidence Score >= 80%?"}:::orchestrator
        
        K_COLL{"Trùng tên ở đích?"}:::orchestrator
        K_RENAME["Đổi tên: thêm _v1, _v2..."]:::orchestrator
        K_COPY["Copy file sang thư mục đích"]:::orchestrator
        K_VERIFY{"MD5 Checksum khớp?"}:::orchestrator
        K_DELETE["Xóa file gốc ở Watcher"]:::orchestrator
        K_ROLLBACK["Rollback file đích + Báo lỗi"]:::fallbackNode
        L["Ghi log thành công"]:::orchestrator
        M["Gửi Slack báo cáo hoàn tất"]:::orchestrator
        N([Folder Đích Đã Sắp Xếp]):::startEnd
    end

    subgraph Brain ["AI Agent (LLM Brain)"]
        D["Phân tích & Phân loại tài liệu"]:::aiNode
        E["Chuẩn hóa tên file theo Policy"]:::aiNode
        F["Tạo Proposed Plan & Confidence"]:::aiNode
    end

    subgraph Portal ["Vibe App & User (HITL Dashboard)"]
        H["Hiển thị đề xuất (Tab Pending)"]:::hitlNode
        H_RED["Hiển thị đề xuất (Tab Cảnh báo đỏ)"]:::fallbackNode
        I["Người dùng duyệt / chỉnh sửa trực tiếp"]:::hitlNode
        J{"Quyết định?"}:::hitlNode
        J_REJ_MOVE["Di chuyển file gốc vào /TuChoi/"]:::fallbackNode
        J_REJ_LOG["Ghi log hủy bỏ"]:::fallbackNode
    end

    %% Flow Connections
    A --> B
    B --> B_EMPTY
    B_EMPTY -->|Không/Trống| B_EXIT
    B_EMPTY -->|Có file| C
    
    %% Duplicate Check
    C --> C_DUP
    C_DUP -->|"Có (Trùng)"| C_DUP_MOVE
    C_DUP_MOVE --> C_DUP_LOG
    C_DUP -->|"Không (Mới)"| FORMAT_CHECK
    
    %% Format & OCR Fallback
    FORMAT_CHECK -->|Ảnh PNG/JPG| OCR_RUN
    FORMAT_CHECK -->|Văn bản DOCX/PDF/TXT| API_CALL
    
    OCR_RUN --> OCR_OK
    OCR_OK -->|Không| H_RED
    OCR_OK -->|Có| API_CALL
    
    %% API Check
    API_CALL --> API_OK
    API_OK -->|Không| API_ERR_MOVE
    API_ERR_MOVE --> API_ERR_ALERT
    API_OK -->|Có| D
    
    %% Brain Process
    D --> E --> F
    F --> G
    
    %% Confidence Routing
    G -->|Đạt >= 80%| H
    G -->|Dưới 80%| H_RED
    
    H --> I
    H_RED --> I
    I --> J
    
    %% User Decision (HITL)
    J -->|"Reject (Từ chối)"| J_REJ_MOVE
    J_REJ_MOVE --> J_REJ_LOG
    J -->|"Approve (Duyệt)"| K_COLL
    
    %% Destination Collision Check
    K_COLL -->|Có| K_RENAME
    K_RENAME --> K_COPY
    K_COLL -->|Không| K_COPY
    
    %% Copy & Checksum Check
    K_COPY --> K_VERIFY
    K_VERIFY -->|Không| K_ROLLBACK
    K_VERIFY -->|Có| K_DELETE
    K_DELETE --> L
    L --> M
    M --> N
