{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "execution_mode", "clips"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "execution_mode": {"const": "SEQUENTIAL"},
    "clips": {
      "type": "array", "minItems": 6, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["clip_id", "scene_id", "frame_id", "image_asset_ref", "duration_seconds", "visual_motion", "audio", "video_prompt", "status", "video_asset_ref", "retry_count", "error_message"],
        "properties": {
          "clip_id": {"type": "string", "pattern": "^CLIP-[0-9]{2}$"},
          "scene_id": {"type": "string", "pattern": "^SC-[0-9]{2}$"},
          "frame_id": {"type": "string", "pattern": "^FR-[0-9]{2}$"},
          "image_asset_ref": {"type": ["string", "null"]},
          "duration_seconds": {"type": "integer", "minimum": 3, "maximum": 10},
          "visual_motion": {
            "type": "object", "additionalProperties": false,
            "required": ["subject", "camera", "environment"],
            "properties": {
              "subject": {"type": "string"}, "camera": {"type": "string"}, "environment": {"type": "string"}
            }
          },
          "audio": {
            "type": "object", "additionalProperties": false,
            "required": ["dialogue", "language", "voice_profile", "delivery", "ambient", "sound_effects", "music", "negative_audio"],
            "properties": {
              "dialogue": {"type": "string"}, "language": {"type": "string", "minLength": 2},
              "voice_profile": {"type": "string"}, "delivery": {"type": "string"}, "ambient": {"type": "string"},
              "sound_effects": {"type": "array", "items": {"type": "string"}},
              "music": {"type": "string"}, "negative_audio": {"type": "array", "items": {"type": "string"}}
            }
          },
          "video_prompt": {"type": "string", "minLength": 1},
          "status": {"enum": ["BLOCKED", "READY_TO_GENERATE", "GENERATING", "SUCCESS", "ERROR", "NEEDS_REVIEW", "APPROVED"]},
          "video_asset_ref": {"type": ["string", "null"]},
          "retry_count": {"type": "integer", "minimum": 0},
          "error_message": {"type": "string"}
        }
      }
    }
  }
}
