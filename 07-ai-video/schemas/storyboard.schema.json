{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "style_bible", "voice_bible", "frames"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "style_bible": {
      "type": "object", "additionalProperties": false,
      "required": ["visual_style", "color_palette", "lighting", "character_consistency", "location_consistency", "forbidden_elements"],
      "properties": {
        "visual_style": {"type": "string", "minLength": 1},
        "color_palette": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "character_consistency": {"type": "string", "minLength": 1},
        "location_consistency": {"type": "string", "minLength": 1},
        "forbidden_elements": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "voice_bible": {
      "type": "object", "additionalProperties": false,
      "required": ["description"],
      "description": "1 mô tả giọng DUY NHẤT cho toàn bộ video — dùng lặp lại y nguyên ở audio.voice_profile của MỌI clip trong video-plan.json, không đổi theo từng scene, để giữ giọng đồng nhất xuyên suốt.",
      "properties": {
        "description": {"type": "string", "minLength": 1, "description": "Tiếng Anh, cụ thể: giới tính, chất giọng (trầm/cao/ấm/sắc), tốc độ nói mặc định, phong cách (chuyên gia tư vấn/thân thiện/nghiêm túc...)."}
      }
    },
    "frames": {
      "type": "array", "minItems": 6, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["frame_id", "scene_id", "composition", "subject", "action", "camera", "image_prompt", "negative_prompt", "status", "image_asset_ref"],
        "properties": {
          "frame_id": {"type": "string", "pattern": "^FR-[0-9]{2}$"},
          "scene_id": {"type": "string", "pattern": "^SC-[0-9]{2}$"},
          "composition": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "camera": {"type": "string", "minLength": 1},
          "image_prompt": {"type": "string", "minLength": 1},
          "negative_prompt": {"type": "string"},
          "status": {"enum": ["DRAFT", "NEEDS_REVIEW", "APPROVED"]},
          "image_asset_ref": {"type": ["string", "null"]}
        }
      }
    }
  }
}
