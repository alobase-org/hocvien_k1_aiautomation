{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_id",
    "version",
    "input_adapters",
    "nodes",
    "edges",
    "execution_policy",
    "approval_gates",
    "retry_policy",
    "logging",
    "cost_guard",
    "test_cases",
    "known_limitations"
  ],
  "properties": {
    "engine_id": {"type": "string"},
    "version": {"type": "string"},
    "input_adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "source_mode", "supported_inputs"],
        "properties": {
          "adapter_id": {"type": "string"},
          "source_mode": {"enum": ["B6_APPROVED", "MANUAL"]},
          "supported_inputs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "purpose", "inputs", "outputs", "config", "state"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "purpose": {"type": "string"},
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port_id", "data_type", "description"],
              "properties": {
                "port_id": {"type": "string"},
                "data_type": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port_id", "data_type", "description"],
              "properties": {
                "port_id": {"type": "string"},
                "data_type": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "state": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_node", "source_port", "target_node", "target_port", "data_type"],
        "properties": {
          "source_node": {"type": "string"},
          "source_port": {"type": "string"},
          "target_node": {"type": "string"},
          "target_port": {"type": "string"},
          "data_type": {"type": "string"}
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "concurrency_limit", "canary_check"],
      "properties": {
        "execution_mode": {"enum": ["SEQUENTIAL", "PARALLEL"]},
        "concurrency_limit": {"type": "integer"},
        "canary_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "sample_size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "sample_size": {"type": "integer"}
          }
        }
      }
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "target_node", "required_status", "fallback_status"],
        "properties": {
          "gate_id": {"type": "string"},
          "target_node": {"type": "string"},
          "required_status": {"type": "string"},
          "fallback_status": {"type": "string"}
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "retry_delay_seconds", "failure_behavior"],
      "properties": {
        "max_retries": {"type": "integer"},
        "retry_delay_seconds": {"type": "integer"},
        "failure_behavior": {"enum": ["STOP_ALL", "SKIP_SCENE", "FAIL_ISOLATED"]}
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_level", "destination", "required_fields"],
      "properties": {
        "log_level": {"enum": ["INFO", "DEBUG", "WARN", "ERROR"]},
        "destination": {"type": "string"},
        "required_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cost_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_credit_per_run", "max_cost_usd_per_run", "warn_threshold_percent"],
      "properties": {
        "max_credit_per_run": {"type": "integer"},
        "max_cost_usd_per_run": {"type": "number"},
        "warn_threshold_percent": {"type": "integer"}
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "description", "input_mock", "expected_outcome"],
        "properties": {
          "case_id": {"type": "string"},
          "description": {"type": "string"},
          "input_mock": {"type": "object", "additionalProperties": true},
          "expected_outcome": {"type": "string"}
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
