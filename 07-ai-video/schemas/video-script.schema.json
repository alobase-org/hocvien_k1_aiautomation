{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-script.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "source_mode", "brief_id", "source_angle_id", "title", "platform", "aspect_ratio", "total_duration_seconds", "target_audience", "brand_style", "forbidden_elements", "scenes"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "source_mode": {"enum": ["B6_APPROVED", "MANUAL"]},
    "brief_id": {"type": ["string", "null"]},
    "source_angle_id": {"type": ["string", "null"], "pattern": "^A-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "platform": {"enum": ["TIKTOK", "REELS", "SHORTS", "OTHER"]},
    "aspect_ratio": {"enum": ["9:16", "16:9", "1:1", "4:5"]},
    "total_duration_seconds": {"type": "integer", "minimum": 24, "maximum": 90},
    "target_audience": {"type": "string", "minLength": 1},
    "brand_style": {"type": "string", "minLength": 1},
    "forbidden_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scenes": {
      "type": "array", "minItems": 6, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scene_id", "source_block", "duration_seconds", "visual", "dialogue"],
        "properties": {
          "scene_id": {"type": "string", "pattern": "^SC-[0-9]{2}$"},
          "source_block": {"enum": ["HOOK", "PROBLEM", "SOLUTION", "CTA"]},
          "duration_seconds": {"type": "integer", "minimum": 3, "maximum": 10},
          "visual": {"type": "string", "minLength": 1},
          "dialogue": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source_mode": {"const": "B6_APPROVED"}}, "required": ["source_mode"]},
      "then": {
        "properties": {
          "brief_id": {"type": "string", "minLength": 1},
          "source_angle_id": {"type": "string", "pattern": "^A-[0-9]{2}$"}
        },
        "description": "B6_APPROVED phải truy vết được về đúng content-draft.json nguồn — brief_id/source_angle_id không được null."
      }
    }
  ]
}
